<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_accounting_product" model="res.groups.privilege">
        <field name="name">Domex: Productos contables</field>
        <field name="category_id" ref="base.module_category_master_data"/>
    </record>
    <record id="group_accounting_product" model="res.groups">
        <field name="name">Producto contable</field>
        <field name="privilege_id" ref="privilege_accounting_product"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Permite acceder a productos marcados como Producto contable sin almacenes asignados, respetando las compañías seleccionadas. No concede permisos de Contabilidad.</field>
    </record>
    <!-- Initial configuration only; later membership changes must survive updates. -->
    <data noupdate="1">
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[Command.link(ref('group_accounting_product'))]"/>
        </record>
    </data>
</odoo>
